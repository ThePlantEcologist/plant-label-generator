# Copy this into Streamlit Community Cloud > your app > Settings > Secrets
# (or to .streamlit/secrets.toml for local testing, which git ignores).
# Leave both sections out and the app runs in guest-only mode.

[auth]
# Must match the redirect URI you add in Google Cloud. Use
# "http://localhost:8501/oauth2callback" when testing on your computer.
redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
cookie_secret = "PASTE-A-LONG-RANDOM-STRING-HERE"
client_id = "PASTE-FROM-GOOGLE-CLOUD.apps.googleusercontent.com"
client_secret = "PASTE-FROM-GOOGLE-CLOUD"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://YOUR-PROJECT-REF.supabase.co"
# Supabase > Project Settings > API Keys > Secret key (starts with sb_secret_).
# Keep this private: it only lives here, never in GitHub.
secret_key = "sb_secret_PASTE-HERE"
